<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_texcore-proceso-venta" targetNamespace="https://texcore.example/bpmn" exporter="TexCore generar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_TexCore">
    <bpmn:participant id="Participant_TexCore" name="Venta, envío y recaudo" processRef="Process_TexCore" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TexCore" name="Venta, envío y recaudo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TexCore">
      <bpmn:lane id="L_GER" name="Gerente">
        <bpmn:flowNodeRef>T25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ALM" name="Almacenista">
        <bpmn:flowNodeRef>T27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_VEN" name="Vendedor">
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_TRA" name="Transportadora (tercero externo)">
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S9" name="Hay producto terminado y un pedido">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="T18" name="Obtener la guía en el portal de la transportadora">
      <bpmn:documentation>Fuera de la app: la guía se genera en el portal de la transportadora antes de facturar.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T19" name="Facturar y anotar la guía (HU 7.1, HU 7.2)">
      <bpmn:documentation>Ventas y Despachos → Nueva venta (cliente, prendas, descuento, transportadora y guía).</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E2" name="Venta rechazada: el sistema lista las faltantes">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G5" name="¿Hay stock?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G6" name="¿Se agrupa en una relación de despacho?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S10" name="Descontar inventario y emitir factura POS en PDF (HU 7.1)">
      <bpmn:documentation>Factura FV-0001 «POS interna» (no es electrónica); movimiento SALIDA_VENTA; PDF descargable.</bpmn:documentation>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T21" name="Armar relación de despacho (HU 7.2)">
      <bpmn:documentation>Envíos → Relaciones de despacho (RD-0001). Opcional.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S11" name="Pasar las guías a En tránsito (HU 7.2)">
      <bpmn:documentation>Todas las guías de la relación pasan a EN_TRANSITO en una sola transacción.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="T22" name="Transportar y entregar el paquete">
      <bpmn:documentation>Fuera de la app: la transportadora transporta, entrega y cobra al cliente.</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T23" name="Consultar estado de la guía (HU 7.2)">
      <bpmn:documentation>Envíos → Guías → botón Consultar estado (permiso envios.gestionar).</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S12" name="Consultar Track123 y actualizar el semáforo (HU 7.2)">
      <bpmn:documentation>Solo Interrapidísimo, solo a petición. Estados: por despachar, en tránsito, con novedad, entregada, devuelta.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G7" name="¿Entregada o devuelta?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T24" name="Conciliar pago contraentrega: Pagado (HU 7.3)">
      <bpmn:documentation>Ventas y Despachos → Gestión de cartera → Confirmar recaudo.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T27" name="Registrar devolución física del paquete (HU 7.2)">
      <bpmn:documentation>Envíos → Guías → detalle de la guía devuelta → Registrar devolución (permiso envios.devolucion).</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S13" name="Sumar recaudo al saldo financiero (HU 7.3)">
      <bpmn:documentation>Movimiento de cartera RECAUDO con saldo antes y después.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S14" name="Reingresar stock y anotar flete al vendedor (HU 7.2)">
      <bpmn:documentation>Movimiento DEVOLUCION_VENTA; el flete queda como flete_vendedor (solo se registra y se reporta).</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E4" name="Devolución registrada">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T25" name="Consultar tablero gerencial y exportar a Excel o CSV (HU 7.4)">
      <bpmn:documentation>Reportes → Tablero gerencial → Exportar Excel (.xlsx) o CSV (.csv).</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Proceso completado">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="T18" targetRef="T19" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="T19" targetRef="G5" />
    <bpmn:sequenceFlow id="Flow_03" name="Sí" sourceRef="G5" targetRef="S10" />
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="G5" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="S10" targetRef="G6" />
    <bpmn:sequenceFlow id="Flow_06" name="Sí" sourceRef="G6" targetRef="T21" />
    <bpmn:sequenceFlow id="Flow_07" name="No" sourceRef="G6" targetRef="T22" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="T21" targetRef="S11" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="S11" targetRef="T22" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T22" targetRef="T23" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T23" targetRef="S12" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="S12" targetRef="G7" />
    <bpmn:sequenceFlow id="Flow_13" name="Entregada" sourceRef="G7" targetRef="T24" />
    <bpmn:sequenceFlow id="Flow_14" name="Devuelta" sourceRef="G7" targetRef="T27" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T24" targetRef="S13" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="S13" targetRef="T25" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T27" targetRef="S14" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="S14" targetRef="E4" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T25" targetRef="E3" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="S9" targetRef="T18" />
    <bpmn:textAnnotation id="A6"><bpmn:text>La guía se genera en el portal de la transportadora, fuera de TexCore.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A6" associationDirection="None" sourceRef="T18" targetRef="A6" />
    <bpmn:textAnnotation id="A7"><bpmn:text>El transporte, la entrega y el cobro al cliente ocurren fuera de TexCore.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A7" associationDirection="None" sourceRef="T22" targetRef="A7" />
    <bpmn:textAnnotation id="A8"><bpmn:text>Solo Interrapidísimo y solo cuando alguien pulsa «Consultar estado».</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A8" associationDirection="None" sourceRef="S12" targetRef="A8" />
    <bpmn:textAnnotation id="A9"><bpmn:text>Hoy la conciliación es manual y no verifica el estado de la guía.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A9" associationDirection="None" sourceRef="T24" targetRef="A9" />
    <bpmn:textAnnotation id="A10"><bpmn:text>El flete solo se registra a nombre del vendedor y se reporta; no se descuenta de ningún pago.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A10" associationDirection="None" sourceRef="S14" targetRef="A10" />
  </bpmn:process>

    <bpmn:sequenceFlow id="Flow_47" name="Devuelta" sourceRef="G7" targetRef="T27" />
    <bpmn:sequenceFlow id="Flow_48" sourceRef="T24" targetRef="S13" />
    <bpmn:sequenceFlow id="Flow_49" sourceRef="S13" targetRef="T25" />
    <bpmn:sequenceFlow id="Flow_50" sourceRef="T27" targetRef="S14" />
    <bpmn:sequenceFlow id="Flow_51" sourceRef="S14" targetRef="E4" />
    <bpmn:sequenceFlow id="Flow_52" sourceRef="T25" targetRef="E3" />
    <bpmn:textAnnotation id="A1"><bpmn:text>No existe «rechazar»: si el Gerente no aprueba, Producción cancela la orden indicando el motivo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A1" associationDirection="None" sourceRef="E1" targetRef="A1" />
    <bpmn:textAnnotation id="A2"><bpmn:text>El lavado lo hace un tercero: ocurre fuera del sistema.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A2" associationDirection="None" sourceRef="T13" targetRef="A2" />
    <bpmn:textAnnotation id="A3"><bpmn:text>Si conformes + merma + dañadas no suman lo enviado, el sistema rechaza y no guarda nada.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A3" associationDirection="None" sourceRef="S4" targetRef="A3" />
    <bpmn:textAnnotation id="A4"><bpmn:text>Las marras se registran con su defecto y no entran al inventario.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A4" associationDirection="None" sourceRef="T15" targetRef="A4" />
    <bpmn:textAnnotation id="A5"><bpmn:text>Opcional: solo cuando hay descuadre; exige un motivo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A5" associationDirection="None" sourceRef="G4" targetRef="A5" />
    <bpmn:textAnnotation id="A6"><bpmn:text>La guía se genera en el portal de la transportadora, fuera de TexCore.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A6" associationDirection="None" sourceRef="T18" targetRef="A6" />
    <bpmn:textAnnotation id="A7"><bpmn:text>El transporte, la entrega y el cobro al cliente ocurren fuera de TexCore.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A7" associationDirection="None" sourceRef="T22" targetRef="A7" />
    <bpmn:textAnnotation id="A8"><bpmn:text>Solo Interrapidísimo y solo cuando alguien pulsa «Consultar estado».</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A8" associationDirection="None" sourceRef="S12" targetRef="A8" />
    <bpmn:textAnnotation id="A9"><bpmn:text>Hoy la conciliación es manual y no verifica el estado de la guía.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A9" associationDirection="None" sourceRef="T24" targetRef="A9" />
    <bpmn:textAnnotation id="A10"><bpmn:text>El flete solo se registra a nombre del vendedor y se reporta; no se descuenta de ningún pago.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A10" associationDirection="None" sourceRef="S14" targetRef="A10" />
  </bpmn:process>

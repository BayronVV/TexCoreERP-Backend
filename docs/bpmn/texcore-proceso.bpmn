<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_texcore-proceso" targetNamespace="https://texcore.example/bpmn" exporter="TexCore generar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_TexCore">
    <bpmn:participant id="Participant_TexCore" name="TexCore ERP: de la materia prima a la venta" processRef="Process_TexCore" />
    <bpmn:participant id="P_LAV" name="Lavandería (tercero externo: lava las prendas fuera de TexCore)" />
    <bpmn:participant id="P_TRA" name="Transportadora (tercero externo: transporta, entrega y cobra el contraentrega)" />
    <bpmn:messageFlow id="M1" name="Remisión REM-LAV y prendas" sourceRef="T12" targetRef="P_LAV" />
    <bpmn:messageFlow id="M2" name="Prendas lavadas y acta de entrega" sourceRef="P_LAV" targetRef="T14" />
    <bpmn:messageFlow id="M3" name="Número de guía (portal)" sourceRef="P_TRA" targetRef="T18" />
    <bpmn:messageFlow id="M4" name="Paquetes despachados" sourceRef="S11" targetRef="P_TRA" />
    <bpmn:messageFlow id="M5" name="Estado del envío (Track123)" sourceRef="P_TRA" targetRef="S12" />
    <bpmn:messageFlow id="M6" name="Dinero del contraentrega" sourceRef="P_TRA" targetRef="T24" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TexCore" name="TexCore ERP: de la materia prima a la venta" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TexCore">
      <bpmn:lane id="L_GER" name="Gerente">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ALM" name="Almacenista">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_JEF" name="Jefe de Producción">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_TER" name="Personal de Terminación">
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_VEN" name="Vendedor">
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Se necesita materia prima">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Solicitar orden de compra (Compras)">
      <bpmn:documentation>Compras → Órdenes de compra → Nueva orden. La orden nace en borrador (OC-0001).</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Aprobar orden de compra (Compras)">
      <bpmn:documentation>Compras → Órdenes de compra → Aprobar (permiso compras.aprobar).</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Aprobada?" default="Flow_04">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Registrar recepción de mercancía (Compras)">
      <bpmn:documentation>Compras → Recepción de mercancía. Quien creó la orden no puede recibirla.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="Orden cancelada">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S1" name="Ingresar al stock, actualizar costo promedio y kardex">
      <bpmn:documentation>Cada fila recibida suma al stock, recalcula el costo promedio ponderado y deja su fila en el kardex.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T4" name="Definir referencia de jean: tallas y colores (HU 3.1)">
      <bpmn:documentation>Referencias de Jean → Catálogo de jeans.</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T5" name="Definir ficha de consumo (HU 3.2)">
      <bpmn:documentation>Catálogo de jeans → botón Ficha técnica.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="Validar material con la simulación (HU 4.1)">
      <bpmn:documentation>Producción y Trazabilidad → Órdenes de producción (Disponibilidad de material).</bpmn:documentation>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="¿Alcanza el material?" default="Flow_13">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Ajustar cantidad al máximo producible (HU 4.1)">
      <bpmn:documentation>Órdenes de producción → botón «Usar N».</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T8" name="Crear orden de producción en lotes (HU 4.2)">
      <bpmn:documentation>Producción y Trazabilidad → Órdenes de producción → Crear orden (OP-0001, lotes OP-0001-L01…).</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S2" name="Descontar el material del almacén (HU 4.2)">
      <bpmn:documentation>En la misma transacción: salida de inventario con la merma de la ficha y foto del costo.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T9" name="Asignar operarios y máquinas (HU 4.4)">
      <bpmn:documentation>Producción y Trazabilidad → Recursos y Seguimiento.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T10" name="Controlar tiempos: corte, confección, terminación (HU 4.3)">
      <bpmn:documentation>Órdenes de producción → Seguimiento (iniciar, pausar, reanudar, terminar).</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T11" name="Seguir lotes en el monitor Kanban (HU 4.5)">
      <bpmn:documentation>Producción y Trazabilidad → Monitor de estado.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T12" name="Emitir remisión REM-LAV a lavandería (HU 5.1)">
      <bpmn:documentation>Procesos Externos (Lavandería) → Remisión a Lavado. El lote queda En tránsito.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T14" name="Registrar recepción con cotejo (HU 5.2)">
      <bpmn:documentation>Procesos Externos (Lavandería) → Recepción de Lavandería (conformes + merma + dañadas = enviadas).</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B1" name="Cotejo no cuadra" attachedToRef="S4">
      <bpmn:documentation>Error: conformes + merma + dañadas no suman lo enviado. No se guarda nada y se corrige el conteo.</bpmn:documentation>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B1_error" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="S4" name="Validar cotejo y asentar acta REC-LAV (HU 5.2)">
      <bpmn:documentation>Si la suma no cuadra, el sistema rechaza y no guarda nada.</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="¿Hay merma o dañadas?" default="Flow_25">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S5" name="Liquidar pérdidas del tercero (HU 5.2)">
      <bpmn:documentation>costo_perdida = (merma + dañadas) × costo unitario de la prenda.</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S6" name="Devolver lote a planta con las conformes (HU 5.2)">
      <bpmn:documentation>El lote vuelve a PLANTA y su cantidad pasa a ser las prendas conformes.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T15" name="Inspeccionar lote: aptas y marras (HU 6.1)">
      <bpmn:documentation>Control de Calidad → Inspecciones (aptas + marras = recibidas conformes).</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T16" name="Ingresar aptas por talla y color al inventario final (HU 6.2)">
      <bpmn:documentation>Producto Terminado → Ingreso.</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S8" name="Actualizar stock y libro de movimientos (HU 6.2)">
      <bpmn:documentation>Saldo por variante nunca negativo; movimiento ENTRADA_PRODUCCION con saldo antes y después.</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="¿Hay descuadre?" default="Flow_32">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T17" name="Ajustar inventario con motivo (HU 6.3)">
      <bpmn:documentation>Producto Terminado → Ajuste manual (movimientos AJUSTE).</bpmn:documentation>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T18" name="Obtener la guía en el portal de la transportadora">
      <bpmn:documentation>Fuera de la app: la guía se genera en el portal de la transportadora antes de facturar.</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T19" name="Facturar y anotar la guía (HU 7.1, HU 7.2)">
      <bpmn:documentation>Ventas y Despachos → Nueva venta (cliente, prendas, descuento, transportadora y guía).</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E2" name="Venta rechazada: el sistema lista las faltantes">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G5" name="¿Hay stock?" default="Flow_37">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G6" name="¿Se agrupa en una relación de despacho?" default="Flow_40">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S10" name="Descontar inventario y emitir factura POS en PDF (HU 7.1)">
      <bpmn:documentation>Factura FV-0001 «POS interna» (no es electrónica); movimiento SALIDA_VENTA; PDF descargable.</bpmn:documentation>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T21" name="Armar relación de despacho (HU 7.2)">
      <bpmn:documentation>Envíos → Relaciones de despacho (RD-0001). Opcional.</bpmn:documentation>
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S11" name="Pasar las guías a En tránsito (HU 7.2)">
      <bpmn:documentation>Todas las guías de la relación pasan a EN_TRANSITO en una sola transacción.</bpmn:documentation>
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T23" name="Consultar estado de la guía (HU 7.2)">
      <bpmn:documentation>Envíos → Guías → botón Consultar estado (permiso envios.gestionar).</bpmn:documentation>
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:incoming>Flow_47</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S12" name="Consultar Track123 y actualizar el semáforo (HU 7.2)">
      <bpmn:documentation>Solo Interrapidísimo, solo a petición. Estados: por despachar, en tránsito, con novedad, entregada, devuelta.</bpmn:documentation>
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G7" name="¿Cómo quedó la entrega?" default="Flow_47">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E6" name="Recaudo pendiente: la factura sigue por cobrar">
      <bpmn:incoming>Flow_49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G8" name="¿Llegó el recaudo?" default="Flow_49">
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T27" name="Registrar devolución física del paquete (HU 7.2)">
      <bpmn:documentation>Envíos → Guías → detalle de la guía devuelta → Registrar devolución (permiso envios.devolucion).</bpmn:documentation>
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S14" name="Reingresar stock y anotar flete al vendedor (HU 7.2)">
      <bpmn:documentation>Movimiento DEVOLUCION_VENTA; el flete queda como flete_vendedor (solo se registra y se reporta).</bpmn:documentation>
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T24" name="Confirmar recaudo de la guía entregada (HU 7.3, HU 7.5)">
      <bpmn:documentation>Ventas y Despachos → Gestión de cartera → Confirmar recaudo (permiso ventas.conciliar: Secretaria y Gerente). Solo se confirma el recaudo de una guía entregada.</bpmn:documentation>
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E4" name="Devolución registrada">
      <bpmn:incoming>Flow_53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S13" name="Sumar recaudo al saldo financiero (HU 7.3)">
      <bpmn:documentation>Movimiento de cartera RECAUDO con saldo antes y después.</bpmn:documentation>
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T25" name="Consultar tablero gerencial y exportar a Excel o CSV (HU 7.4)">
      <bpmn:documentation>Reportes → Tablero gerencial → Exportar Excel (.xlsx) o CSV (.csv).</bpmn:documentation>
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Proceso completado">
      <bpmn:incoming>Flow_54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="S0" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="G1" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_05" name="Sí" sourceRef="G1" targetRef="T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">orden aprobada por el Gerente</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="T3" targetRef="S1" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="S1" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="G2" targetRef="T7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alcanza para menos prendas de las pedidas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="Sí" sourceRef="G2" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">el material alcanza para todo el pedido</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="No: falta material, solicitar compra" sourceRef="G2" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T8" targetRef="S2" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="S2" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="T12" targetRef="T14" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T14" targetRef="S4" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="S4" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="B1" targetRef="T14" />
    <bpmn:sequenceFlow id="Flow_24" name="Sí" sourceRef="G3" targetRef="S5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">merma + dañadas &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" name="No" sourceRef="G3" targetRef="S6" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="S5" targetRef="S6" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="S6" targetRef="T15" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="T15" targetRef="T16" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="T16" targetRef="S8" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="S8" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_31" name="Sí" sourceRef="G4" targetRef="T17">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">el conteo físico no coincide con el sistema</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_32" name="No" sourceRef="G4" targetRef="T18" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="T17" targetRef="T18" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="T18" targetRef="T19" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="T19" targetRef="G5" />
    <bpmn:sequenceFlow id="Flow_36" name="Sí" sourceRef="G5" targetRef="S10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hay stock de todas las tallas y colores pedidos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_37" name="No" sourceRef="G5" targetRef="E2" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="S10" targetRef="G6" />
    <bpmn:sequenceFlow id="Flow_39" name="Sí" sourceRef="G6" targetRef="T21">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">se despachan varias guías juntas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_40" name="No" sourceRef="G6" targetRef="T23" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="T21" targetRef="S11" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="S11" targetRef="T23" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="T23" targetRef="S12" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="S12" targetRef="G7" />
    <bpmn:sequenceFlow id="Flow_45" name="Entregada" sourceRef="G7" targetRef="G8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">estado de la guía = entregada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_46" name="Devuelta" sourceRef="G7" targetRef="T27">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">estado de la guía = devuelta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_47" name="Con novedad o en tránsito: volver a consultar" sourceRef="G7" targetRef="T23" />
    <bpmn:sequenceFlow id="Flow_48" name="Sí" sourceRef="G8" targetRef="T24">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">la transportadora entregó el dinero del contraentrega</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_49" name="No" sourceRef="G8" targetRef="E6" />
    <bpmn:sequenceFlow id="Flow_50" sourceRef="T24" targetRef="S13" />
    <bpmn:sequenceFlow id="Flow_51" sourceRef="S13" targetRef="T25" />
    <bpmn:sequenceFlow id="Flow_52" sourceRef="T27" targetRef="S14" />
    <bpmn:sequenceFlow id="Flow_53" sourceRef="S14" targetRef="E4" />
    <bpmn:sequenceFlow id="Flow_54" sourceRef="T25" targetRef="E3" />
    <bpmn:textAnnotation id="A1"><bpmn:text>No existe «rechazar»: si el Gerente no aprueba, Producción cancela la orden indicando el motivo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A1" associationDirection="None" sourceRef="E1" targetRef="A1" />
    <bpmn:textAnnotation id="A4"><bpmn:text>Defectos: las marras se registran con su defecto, restan de las aptas y no entran al inventario.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A4" associationDirection="None" sourceRef="T15" targetRef="A4" />
    <bpmn:textAnnotation id="A5"><bpmn:text>Opcional: solo cuando hay descuadre; exige un motivo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A5" associationDirection="None" sourceRef="G4" targetRef="A5" />
    <bpmn:textAnnotation id="A8"><bpmn:text>Solo Interrapidísimo y solo cuando alguien pulsa «Consultar estado».</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A8" associationDirection="None" sourceRef="S12" targetRef="A8" />
    <bpmn:textAnnotation id="A10"><bpmn:text>El flete solo se registra a nombre del vendedor y se reporta; no se descuenta de ningún pago.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_A10" associationDirection="None" sourceRef="S14" targetRef="A10" />
  </bpmn:process>

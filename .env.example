# Copia este archivo como .env y completa los valores. El .env NO se versiona.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# true en desarrollo, false en producción
DJANGO_DEBUG=true
# Hosts permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Nombre del entorno que muestra /api/health/ (local, dev, prod)
APP_ENV=local

# --- Base de datos (Supabase / Postgres) ---
# Supabase > Project Settings > Database > Connect > "Session pooler".
# Formato: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Proyecto texcore-dev para desarrollo diario; texcore-prod solo para producción.
# Si se deja vacío se usa SQLite local (útil sin conexión).
DATABASE_URL=
# Supabase exige SSL. Pon false solo para un Postgres local sin SSL.
DB_SSL_REQUIRE=true
# Segundos que se reutiliza una conexión. Déjalo en 0 con runserver: un valor
# mayor deja conexiones abiertas y agota el pool de Supabase (15 conexiones).
DB_CONN_MAX_AGE=0

# --- Proxy ---
# Cantidad de proxies delante del backend (0 en local). Con 0 se ignora el
# header X-Forwarded-For, que cualquiera podría falsificar.
NUM_PROXIES=0
# En Render usar 1 (ver docs/despliegue-render.md).

# --- CORS ---
# Orígenes del frontend autorizados a llamar a la API, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (opcional, reservado para Storage/Auth en sprints futuros) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Correo y recuperación de contraseña (HU 1.3) ---
# Por defecto los correos se imprimen en la consola del runserver.
# Para guardarlos como archivos .eml (y abrirlos con doble clic):
#   EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
#   EMAIL_FILE_PATH=tmp/emails
# Para enviarlos de verdad (p. ej. Gmail con contraseña de aplicación):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=...  EMAIL_HOST_PASSWORD=...
# Render (plan gratuito) bloquea los puertos 25/465/587: ver docs/despliegue-render.md.
# EMAIL_TIMEOUT=10   # segundos máximos de espera al servidor SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TexCore ERP <no-reply@texcore.local>
# URL del frontend para armar el enlace del correo
FRONTEND_URL=http://localhost:5173
# Vigencia del enlace de recuperación (RF02) y de la invitación de cuentas nuevas
PASSWORD_RESET_TOKEN_MINUTES=15
ACCOUNT_INVITE_TOKEN_HOURS=48

# --- Seed de administrador (opcional) ---
# Usadas solo por `python manage.py seed_admin`. Sin definirlas, el comando
# usa admin@texcore.test / Admin#2026 (solo válido con DJANGO_DEBUG=true).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Evidencias de inventario ---
# Carpeta donde se guardan las fotos y PDF adjuntos (por defecto backend/media)
MEDIA_ROOT=

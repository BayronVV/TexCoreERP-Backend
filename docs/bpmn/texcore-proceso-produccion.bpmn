      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6" ><dc:Bounds x="985" y="498" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true" ><dc:Bounds x="1200" y="515" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1108" y="506" width="90" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
